// Dependency-free Peal sound player — generated by the Peal CLI.
const SOUND_FILES = {{SOUND_FILES}};

const clampVolume = (volume) => Math.max(0, Math.min(1, volume));

export class PealPlayer {
  constructor(basePath = './peal') {
    this.basePath = basePath;
    this.volume = 0.7;
    this.muted = false;
    this.preloaded = new Map();
    this.active = new Map();
    this.preloadSounds();
  }

  preloadSounds() {
    if (typeof Audio === 'undefined') return;
    Object.entries(SOUND_FILES).forEach(([name, file]) => {
      const audio = new Audio(`${this.basePath}/${file}`);
      audio.preload = 'auto';
      this.preloaded.set(name, audio);
    });
  }

  createAudio(soundName) {
    if (typeof Audio === 'undefined') return undefined;
    const file = SOUND_FILES[soundName];
    if (!file) return undefined;

    let template = this.preloaded.get(soundName);
    if (!template) {
      template = new Audio(`${this.basePath}/${file}`);
      template.preload = 'auto';
      this.preloaded.set(soundName, template);
    }
    return template.cloneNode(true);
  }

  play(soundName, options = {}) {
    if (!SOUND_FILES[soundName]) {
      console.warn(`Sound "${soundName}" not found`);
      return undefined;
    }

    const audio = this.createAudio(soundName);
    if (!audio) return undefined;

    audio.volume = clampVolume(options.volume ?? this.volume);
    audio.loop = options.loop ?? false;
    audio.muted = this.muted;

    const playing = this.active.get(soundName) ?? new Set();
    playing.add(audio);
    this.active.set(soundName, playing);

    const cleanup = () => {
      playing.delete(audio);
      if (playing.size === 0) this.active.delete(soundName);
    };
    audio.addEventListener('ended', cleanup, { once: true });
    audio.addEventListener('error', cleanup, { once: true });
    audio.play().catch((error) => {
      cleanup();
      console.warn(`Could not play "${soundName}": ${error.message}`);
    });
    return audio;
  }

  forEachActive(soundName, callback) {
    const entries = soundName
      ? [[soundName, this.active.get(soundName)]]
      : this.active.entries();
    for (const [name, sounds] of entries) {
      if (!sounds) continue;
      for (const audio of sounds) callback(audio, name, sounds);
    }
  }

  stop(soundName) {
    this.forEachActive(soundName, (audio, name, sounds) => {
      audio.pause();
      audio.currentTime = 0;
      sounds.delete(audio);
      if (sounds.size === 0) this.active.delete(name);
    });
  }

  pause(soundName) {
    this.forEachActive(soundName, (audio) => audio.pause());
  }

  resume(soundName) {
    this.forEachActive(soundName, (audio) => void audio.play());
  }

  setVolume(volume) {
    this.volume = clampVolume(volume);
    this.forEachActive(undefined, (audio) => { audio.volume = this.volume; });
  }

  mute(muted = true) {
    this.muted = muted;
    this.forEachActive(undefined, (audio) => { audio.muted = muted; });
  }

{{CONVENIENCE_METHODS}}
}

export const peal = new PealPlayer();
export default PealPlayer;
